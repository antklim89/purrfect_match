{
  "name": "@purrfect_match/api",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts"
    }
  },
  "module": "index.ts",
  "scripts": {
    "db:generate": "bun  drizzle-kit generate",
    "db:migrate": "bun --bun src/migrate.ts",
    "dev": "run-p dev:**",
    "dev:app": "bun run --hot src/app.ts",
    "dev:typecheck": "bun typecheck -w --preserveWatchOutput",
    "lint": "biome check",
    "seed": "bun --bun src/seed.ts",
    "start": "bun run src/app.ts",
    "studio": "drizzle-kit studio",
    "test": "bun run --bun vitest",
    "typecheck": "bun --bun tsc -p tsconfig.json"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@electric-sql/pglite": "^0.5.3",
    "@hono/zod-validator": "^0.8.0",
    "@purrfect_match/shared": "workspace:*",
    "better-auth": "^1.6.22",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "catalog:",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "sharp": "^0.35.2",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bun": "catalog:",
    "drizzle-kit": "^1.0.0-rc.4",
    "npm-run-all2": "catalog:",
    "vite": "^8.3.0"
  }
}
