{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["../../tsconfig.json"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@purrfect_match/api/*": ["./src/*"]
    },
  "declaration": true,
  "emitDeclarationOnly": true,
  "declarationDir": "dist",
  "noEmit": false,
  "noCheck": true,
  "preserveWatchOutput": true,

  "rootDir": "src"
  },
  "display": "Hono",
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
