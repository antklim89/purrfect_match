{
  "name": "@purrfect_match/web",
  "version": "0.1.0",
  "private": true,
  "description": "Template",
  "type": "module",
  "scripts": {
    "build": "bun --parallel build:*",
    "build:lint": "bun lint",
    "build:next": "bun next build",
    "build:typecheck": "bun typecheck",
    "dev": "bun --parallel dev:*",
    "dev:next": "bun --bun next dev -H 0.0.0.0",
    "dev:typecheck": "bun typecheck -w",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:start": "docker compose start",
    "docker:up": "docker compose up",
    "lint": "biome check",
    "start": "bun next start",
    "typecheck": "tsc --preserveWatchOutput --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/figtree": "^5.2.10",
    "@purrfect_match/api": "workspace:*",
    "@purrfect_match/shared": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "hono": "catalog:",
    "lucide-react": "^1.21.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bun": "catalog:",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "catalog:"
  }
}
