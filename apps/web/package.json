{
  "name": "@purrfect_match/web",
  "version": "0.1.0",
  "private": true,
  "description": "Template",
  "type": "module",
  "scripts": {
    "build": "run-s build:**",
    "build:lint": "bun lint",
    "build:typecheck": "bun typecheck",
    "build:next": "bun next build",
    "dev": "run-p dev:**",
    "dev:next": "bun next dev -H 0.0.0.0",
    "dev:typecheck": "bun typecheck -w --preserveWatchOutput",
    "docker:build": "docker compose build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:start": "docker compose start",
    "docker:up": "docker compose up",
    "lint": "biome check",
    "start": "bun next start",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/figtree": "^5.2.10",
    "@purrfect_match/shared": "workspace:*",
    "@tanstack/react-form": "^1.33.2",
    "better-auth": "^1.6.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.12.27",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.12.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.15",
    "sass": "^1.101.0",
    "tailwindcss": "^4.3.1"
  }
