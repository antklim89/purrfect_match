{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 120,
      "quoteStyle": "single"
    }
  },
  "linter": {
    "domains": {
      "drizzle": "all",
      "react": "all",
      "next": "all",
      "tailwind": "all",
      "test": "all",
      "types": "all",
      "solid": "none",
      "qwik": "none"
    },
    "enabled": true,
    "rules": {
      "a11y": {
        "useMediaCaption": "off"
      },
      "correctness": {
        "noProcessGlobal": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              { "group": ["**/entities/*/*/**", "**/pages/*/*/**", "**/features/*/*/**", "**/widgets/*/*/**"] }
            ]
          }
        }
      }
    }
  }
}
